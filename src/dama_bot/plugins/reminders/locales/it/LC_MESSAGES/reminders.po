msgid "Reminder successfully created for {time}."
msgstr "Promemoria creato con successo per il {time}."

msgid "You currently have no active reminders."
msgstr "Non hai promemoria attivi al momento."

msgid "Here are your active reminders:"
msgstr "Ecco i tuoi promemoria attivi:"

msgid "- [{id}] \"{text}\" scheduled for {time}"
msgstr "- [{id}] \"{text}\" programmato per il {time}"

msgid "Reminder {id} successfully deleted."
msgstr "Promemoria {id} eliminato con successo."

msgid "Reminder with ID {id} not found or you are not authorized to delete it."
msgstr "Promemoria con ID {id} non trovato o non sei autorizzato a eliminarlo."

msgid "Reminder with ID {id} not found or you are not authorized to edit it."
msgstr "Promemoria con ID {id} non trovato o non sei autorizzato a modificarlo."

msgid "Reminder {id} successfully updated. New status: \"{text}\" for {time}."
msgstr "Promemoria {id} aggiornato con successo. Nuovo stato: \"{text}\" per il {time}."

msgid "Invalid date format '{date_str}'. Use ISO format YYYY-MM-DDTHH:MM:SS."
msgstr "Formato data '{date_str}' non valido. Usa il formato YYYY-MM-DDTHH:MM:SS."

msgid "Cannot schedule a reminder in the past. Please specify a future date and time."
msgstr "Non posso programmare un promemoria nel passato. Specifica una data e ora futura."

msgid "Error creating reminder: {error}"
msgstr "Errore durante la creazione del promemoria: {error}"

msgid "Error retrieving reminders: {error}"
msgstr "Errore durante il recupero dei promemoria: {error}"

msgid "Error deleting reminder: {error}"
msgstr "Errore durante l'eliminazione del promemoria: {error}"

msgid "Error updating reminder: {error}"
msgstr "Errore durante l'aggiornamento del promemoria: {error}"

msgid "Reminder:\n\n{text}"
msgstr "Ricordati:\n\n{text}"

msgid "%d/%m/%Y at %H:%M"
msgstr "%d/%m/%Y alle %H:%M"
